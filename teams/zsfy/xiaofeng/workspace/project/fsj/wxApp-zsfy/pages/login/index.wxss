/* pages/login/index.wxss */
page {
  --wechat-green: #07C160;
  --text-secondary: #999;
}

.login-container {
  min-height: 100vh;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 64rpx;
}

.login-content {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.wechat-icon-wrap {
  width: 200rpx;
  height: 200rpx;
  background: var(--wechat-green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}

.wechat-icon {
  width: 100%;
  height: 100%;
}

.login-bottom {
  position: fixed;
  bottom: 80rpx;
  left: 64rpx;
  right: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: var(--wechat-green);
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn:active {
  opacity: 0.8;
}

.tip-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.tip-text .link {
  color: var(--wechat-green);
}

/* ========== 协议复选框样式 ========== */
.agreement-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 0 20rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  margin-top: 2rpx;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: var(--wechat-green);
  border-color: var(--wechat-green);
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
}

.agreement-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.agreement-text .link {
  color: var(--wechat-green);
}

/* ========== 登录按钮禁用状态 ========== */
.login-btn.disabled {
  background: #ccc;
  color: #999;
}

/* ========== 暂不登录按钮 ========== */
.skip-login-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.skip-login-btn text {
  font-size: 28rpx;
  color: #999;
}

.skip-login-btn:active {
  opacity: 0.6;
}
