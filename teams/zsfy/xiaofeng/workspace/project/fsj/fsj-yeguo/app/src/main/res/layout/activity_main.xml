<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥥 椰果 · 桌面宠物助手"
            android:textColor="#4E342E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:text="状态加载中…"
            android:textColor="#6D4C41"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="—— 权限与开关 ——"
            android:textColor="#8D6E63"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="① 悬浮窗权限（必须）" />

        <Button
            android:id="@+id/btn_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② 通知权限（提醒用）" />

        <Button
            android:id="@+id/btn_alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="③ 精确闹钟权限（提醒准点）" />

        <Button
            android:id="@+id/btn_mic_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="④ 麦克风权限（语音输入）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="放出椰果" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="收回" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="—— 大模型配置（OpenAI 兼容，默认 DeepSeek）——"
            android:textColor="#8D6E63"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_llm_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Base URL（如 https://api.deepseek.com/v1）"
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_llm_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="API Key（只存在手机里，不进代码）"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_llm_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="模型名（如 deepseek-chat）"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_save_llm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="保存模型配置" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="—— HAP 通道（经 Node 代理，密钥不进 APP）——"
            android:textColor="#8D6E63"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_hap_proxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Node 代理地址"
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_hap_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="HAP 站点地址（如 https://hap.xxx.cn）"
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_hap_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="椰果记忆表 worksheetId（留空=暂不同步）"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_save_hap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="保存 HAP 配置" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="—— 语音播报 ——"
            android:textColor="#8D6E63"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_tts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="椰果的回复用语音念出来"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="10dp" />

        <Button
            android:id="@+id/btn_tts_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="试听当前音色" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="—— 提醒 ——"
            android:textColor="#8D6E63"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="提醒内容（如：开会）"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选时间 · 加提醒" />

        <Button
            android:id="@+id/btn_reminder_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1 分钟后测试提醒（验证链路）" />

        <Button
            android:id="@+id/btn_notify_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="立即测试通知（看下拉栏）" />

        <TextView
            android:id="@+id/tv_reminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#6D4C41"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>
